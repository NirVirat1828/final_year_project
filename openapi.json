{
  "openapi": "3.1.0",
  "info": {
    "title": "Electronic Tongue Orange Freshness API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyze-batch": {
      "post": {
        "summary": "Analyze Batch",
        "operationId": "analyze_batch_api_v1_analyze_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfidenceInterval": {
        "properties": {
          "lower_bound": {
            "type": "number",
            "title": "Lower Bound"
          },
          "upper_bound": {
            "type": "number",
            "title": "Upper Bound"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lower_bound",
          "upper_bound"
        ],
        "title": "ConfidenceInterval"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceLogistics": {
        "properties": {
          "estimated_age_days": {
            "type": "number",
            "title": "Estimated Age Days"
          },
          "remaining_shelf_life_days": {
            "type": "number",
            "title": "Remaining Shelf Life Days"
          },
          "confidence_interval": {
            "$ref": "#/components/schemas/ConfidenceInterval"
          },
          "temperature_warning": {
            "type": "string",
            "title": "Temperature Warning"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "estimated_age_days",
          "remaining_shelf_life_days",
          "confidence_interval",
          "temperature_warning"
        ],
        "title": "InferenceLogistics"
      },
      "InferenceRequest": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "sensor_readings": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Sensor Readings"
          },
          "preprocessing_strategy": {
            "type": "string",
            "title": "Preprocessing Strategy",
            "default": "raw"
          },
          "storage_temperature_c": {
            "type": "number",
            "title": "Storage Temperature C",
            "default": 4.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batch_id",
          "sensor_readings"
        ],
        "title": "InferenceRequest"
      },
      "InferenceResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "processing_latency_ms": {
            "type": "number",
            "title": "Processing Latency Ms"
          },
          "results": {
            "$ref": "#/components/schemas/InferenceResults"
          },
          "logistics": {
            "$ref": "#/components/schemas/InferenceLogistics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "batch_id",
          "processing_latency_ms",
          "results",
          "logistics"
        ],
        "title": "InferenceResponse"
      },
      "InferenceResults": {
        "properties": {
          "freshness_grade": {
            "type": "string",
            "title": "Freshness Grade"
          },
          "grade_description": {
            "type": "string",
            "title": "Grade Description"
          },
          "folic_acid_uM": {
            "type": "number",
            "title": "Folic Acid Um"
          },
          "nutritional_status": {
            "type": "string",
            "title": "Nutritional Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "freshness_grade",
          "grade_description",
          "folic_acid_uM",
          "nutritional_status"
        ],
        "title": "InferenceResults"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}